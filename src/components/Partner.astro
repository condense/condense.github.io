---
// "Partner with us" page (/partner). Copy + rationale live in src/copy/partner.ts.
// Linked from the footer (Practice column); not in the top nav.
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import TitleBlock from './TitleBlock.astro';
import { partner } from '../copy/partner.ts';
const { hero, offers, fit } = partner;
---
<Nav />
<main>
  <section class="sec lead" id="top">
    <div class="lead-grid">
      <div>
        <h1 class="lead-title">{hero.heading.before}<span class="accent">{hero.heading.accent}{hero.heading.after}</span></h1>
        <p class="lede">{hero.lede}</p>
        <div class="actions">
          <a class="btn btn-ghost" href={hero.actions.ghost.href}>{hero.actions.ghost.label}</a>
        </div>
      </div>
      <TitleBlock label={hero.actions.primary.label} href={hero.actions.primary.href} />
    </div>
  </section>

  <section class="sec">
    <p class="rail"><span>{offers.eyebrow}</span></p>
    <div class="sec-head">
      <h2 class="sec-title">{offers.title}</h2>
      <p class="sec-lede">{offers.lede}</p>
    </div>
    <div class="spec spec--two">
      {offers.cards.map((o) => (
        <div class="spec-row">
          <h3>{o.title}</h3>
          <p>{o.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="sec sec--teal sec--end">
    <p class="rail"><span>{fit.eyebrow}</span></p>
    <h2 class="contact-title">{fit.title}</h2>
    <div class="contact-panel">
      <p class="contact-body">{fit.lede}</p>
      <div class="actions">
        <a class="btn btn-primary" href={fit.action.href}>
          {fit.action.label}
          <span class="arr"><Icon name="arrow" size={18} /></span>
        </a>
      </div>
    </div>
  </section>
</main>
<Footer />
