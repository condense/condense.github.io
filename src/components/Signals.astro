---
// "Sound familiar?" — lets a buyer self-identify by the moment they're in.
// Rendered as issues marked up on the drawing. Copy lives in src/copy/home.ts.
import { home } from '../copy/home.ts';
const { eyebrow, title, lede, items } = home.signals;
---
<section class="sec" id="signals">
  <p class="rail"><span>{eyebrow}</span></p>
  <div class="sec-head sec-head--stack">
    <h2 class="sec-title">{title}</h2>
    <p class="sec-lede">{lede}</p>
  </div>
  <ul class="issues">
    {items.map((s) => <li>{s}</li>)}
  </ul>
</section>
