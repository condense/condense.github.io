---
// Three stations on one line. Copy lives in src/copy/home.ts.
import { home } from '../copy/home.ts';
const { eyebrow, title, lede, steps } = home.approach;
---
<section class="sec" id="approach">
  <p class="rail"><span>{eyebrow}</span></p>
  <div class="sec-head">
    <h2 class="sec-title">{title}</h2>
    <p class="sec-lede">{lede}</p>
  </div>
  <ol class="steps">
    {steps.map((s) => (
      <li class="step">
        <div class="num" aria-hidden="true">{s.num}</div>
        <h3>{s.title}</h3>
        <p>{s.body}</p>
      </li>
    ))}
  </ol>
</section>
