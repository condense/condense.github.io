---
// Homepage Services — the four ways live data goes bad, and what we build in against each.
// Rendered as a ruled schedule: one row per capability. Copy lives in src/copy/home.ts.
import { home } from '../copy/home.ts';
const { eyebrow, title, lede, cards } = home.services;
---
<section class="sec" id="services">
  <p class="rail"><span>{eyebrow}</span></p>
  <div class="sec-head">
    <h2 class="sec-title">{title}</h2>
    <p class="sec-lede">{lede}</p>
  </div>
  <div class="spec">
    {cards.map((s) => (
      <div class="spec-row" id={s.anchor}>
        <h3>{s.title}</h3>
        <p>{s.body}</p>
        <ul class="tags">{s.tags.map((t) => <li>{t}</li>)}</ul>
      </div>
    ))}
  </div>
</section>
