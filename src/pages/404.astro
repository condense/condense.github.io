---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import TitleBlock from '../components/TitleBlock.astro';
import { site } from '../copy/site.ts';
const { notFound, contact } = site;
---
<Base title="Page not found — Condense">
  <Nav />
  <main>
    <section class="sec lead" id="top">
      <div class="lead-grid">
        <div>
          <h1 class="lead-title">{notFound.title}</h1>
          <p class="lede">{notFound.lede}</p>
          <div class="actions">
            <a class="btn btn-ghost" href={`mailto:${contact.email}`}>{notFound.actions.email.label}</a>
          </div>
        </div>
        <TitleBlock label={notFound.actions.home.label} href={notFound.actions.home.href} />
      </div>
    </section>
  </main>
  <Footer />
</Base>
